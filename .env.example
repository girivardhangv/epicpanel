# EpicPanel API configuration (environment variables)
# Copy relevant lines into your shell profile, systemd unit, or IIS launch env.
# NEVER commit real secrets.

# --- Database -----------------------------------------------------------------
# PostgreSQL >= 13 required. Provisioned BEFORE first panel start.
EPICPANEL_DATABASE_DSN=postgres://postgres:change-me@127.0.0.1:5432/epicpanel?sslmode=disable
# EPICPANEL_DATABASE_MAX_CONNS=20

# --- HTTP server --------------------------------------------------------------
EPICPANEL_SERVER_ADDR=:8080
# development | production  (production forces Secure cookies, JSON logs)
EPICPANEL_SERVER_ENVIRONMENT=development
# EPICPANEL_SERVER_PUBLIC_URL=https://panel.example.com
# CIDR of a single trusted reverse proxy for X-Forwarded-For (empty = none)
# EPICPANEL_SERVER_TRUSTED_PROXY=10.0.0.0/24

# --- Security -----------------------------------------------------------------
# EPICPANEL_SECURITY_SESSION_LIFETIME=24h
# EPICPANEL_SECURITY_MAX_FAILED_LOGINS=10
# EPICPANEL_SECURITY_ACCOUNT_LOCKOUT=15m
# EPICPANEL_SECURITY_LOGIN_RATE_PER_MINUTE=20
# EPICPANEL_SECURITY_GLOBAL_RATE_PER_MINUTE=600
# EPICPANEL_SECURITY_PASSWORD_MIN_LENGTH=12
# EPICPANEL_SECURITY_PASSWORD_REQUIRE_CLASSES=3
# Force cookie Secure flag independently of environment detection:
# EPICPANEL_SECURITY_COOKIE_SECURE=true

# --- Licensing ----------------------------------------------------------------
# Root of your licensing service implementing the /v1 contract in docs/api.md.
# For local development run scripts/licensing-server (DEV ONLY stub).
EPICPANEL_LICENSE_API_URL=http://127.0.0.1:9911
# EPICPANEL_LICENSE_TIMEOUT=10s
# EPICPANEL_LICENSE_GRACE_ENABLED=true
# EPICPANEL_LICENSE_GRACE_PERIOD=72h
# EPICPANEL_LICENSE_REVALIDATE_EVERY=6h

# --- Files --------------------------------------------------------------------
# Directory for panel-managed files (config overlay data/panel.json)
# EPICPANEL_DATA_DIR=data
# Serve a prebuilt SPA from the Go binary instead of an external host:
# EPICPANEL_DIST_DIR=../frontend/dist
# EPICPANEL_CONFIG_FILE=data/panel.json

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
# EPICPANEL_LOG_LEVEL=info

# --- Agent (set on MANAGED SERVERS, not the panel host) -----------------------
# EPICPANEL_URL=https://panel.example.com
# EPICPANEL_AGENT_KEY=<registration key from Servers page>
# EPICPANEL_AGENT_LABEL=web-prod-01
# EPICPANEL_AGENT_DIR=/var/lib/epicpanel-agent
# EPICPANEL_CA_FILE=/etc/epicpanel/internal-ca.pem
