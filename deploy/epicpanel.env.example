# EpicPanel API environment — every EPICPANEL_* variable read by
# backend/internal/config/config.go, with safe production defaults.
#
# Install: cp deploy/epicpanel.env.example /etc/epicpanel/api.env
#          chmod 640 /etc/epicpanel/api.env  (root:epicpanel-api)
# Secrets: NEVER commit the real file. Provision EPICPANEL_SECRET_KEY and
#          EPICPANEL_DATABASE_URL out-of-band (see docs/operator-guide.md
#          "Secrets provisioning").

# --- Required ---------------------------------------------------------------

# Postgres DSN. sslmode=disable only for a localhost socket/TCP on a private
# box; use verify-full with a CA bundle for a remote DB.
EPICPANEL_DATABASE_URL=postgres://epicpanel:CHANGE_ME@127.0.0.1:5432/epicpanel?sslmode=disable

# 64 hex chars of entropy: openssl rand -hex 32. Rotating it invalidates
# sessions (cookies are MAC'd); rotate only with a maintenance window.
EPICPANEL_SECRET_KEY=CHANGE_ME_openssl_rand_hex_64_chars

# --- Listen address ----------------------------------------------------------
# 0.0.0.0 to accept traffic behind nginx; 127.0.0.1 for localhost-only.
EPICPANEL_HTTP_ADDR=0.0.0.0:8080

# development | production. production enables Secure cookies.
EPICPANEL_ENV=production

# --- Sessions ----------------------------------------------------------------
# Go duration. Default 720h (30 days) when unset.
EPICPANEL_SESSION_TTL=720h

# Override Secure-cookie inference (default: true when EPICPANEL_ENV=production).
# Leave unset unless terminating TLS somewhere unusual.
# EPICPANEL_COOKIE_SECURE=true

# --- CORS / browser ------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser and to
# open GET /v1/ws (Origin check). The React app's origin must be listed.
EPICPANEL_CORS_ORIGINS=https://panel.example.com

# CIDRs allowed to set X-Forwarded-For (your nginx/LB). Empty = never trust
# the header (direct connections only). Example:
# EPICPANEL_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32

# --- Event bus ------------------------------------------------------------------
# Unset (default): Postgres LISTEN/NOTIFY driver — zero extra infrastructure.
# Set to redis://host:6379/0 to switch WS fan-out across >=2 API replicas.
EPICPANEL_REDIS_URL=

# --- Background jobs --------------------------------------------------------------
# Liveness-check cadence for the monitoring checker. Default 60s.
EPICPANEL_HEALTH_CHECK_INTERVAL=60s
